# Secrets - never commit. .env.example documents the keys instead.
.env
.env.*
!.env.example

# Image data. GitHub rejects any file over 100 MB and images.zip is 421 MB;
# Section 3 downloads and extracts it on first run, so it never needs to be here.
data/

# Run outputs: image cache, checkpoints, TensorBoard events, submissions.
# ~900 MB, and every byte of it is regenerated by a run.
artifacts/
artifacts_kraken/
logs/
submission.csv
submission_kraken.csv
submission_ensemble.csv
.venv_kraken/

# Local pip / flash-attn download scratch (kept on the workspace mount).
.cache/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
