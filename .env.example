# Copy to .env and fill in. .env is gitignored and must never be committed.
# The pipeline reads these at start-up; nothing is hard-coded in the notebook.

# --- Hugging Face -----------------------------------------------------------
# Write token from https://huggingface.co/settings/tokens
HF_TOKEN=""
HF_REPO_ID="your-name/road-barbados-htr"

# --- Email notifications (optional) -----------------------------------------
# Gmail requires an App Password (16 characters), not the account password:
# https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
NOTIFY_EMAIL_TO=""
